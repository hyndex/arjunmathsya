---
// (b) Product adoption-path comparison. Rows align across products (subgrid) so each phase can be read across.
import { ArrowRight } from '@lucide/astro';
import { PRODUCTS, STAGES } from '@/data/products';
import { HARDWARE_GATES } from '@/data/portfolio';
import { ADOPTION, ADOPTION_PHASES } from '@/data/investors';

const order = ['battery', 'evo', 'pmg'] as const;
---

<div class="pf">
  <p class="pf-legend">
    <span class="pf-legend-k">Maturity scale</span>
    <span>{STAGES.join(' → ')}</span>
    <span class="pf-key" aria-hidden="true">
      <i class="on"></i> reached <i class="cur"></i> current <i></i> not reached
    </span>
  </p>

  <div class="pf-grid">
    {
      order.map((id) => {
        const p = PRODUCTS[id];
        const a = ADOPTION[id];
        return (
          <article class={`pf-col inv-pc-${id}`} aria-labelledby={`pf-${id}`}>
            <header class="pf-head">
              <p class="pf-kind">{p.kind}</p>
              <h3 class="h3" id={`pf-${id}`}>
                {p.name}
              </h3>
            </header>
            <div class="pf-stage">
              <span class={`stage stage--${id}`}>{p.stage}</span>
              <div
                class="meter"
                style={`--meter:${p.accent}`}
                role="img"
                aria-label={`Maturity: working on “${STAGES[p.stageIndex]}”. Not yet evaluated, validated or commercially released.`}
              >
                {STAGES.map((_, i) => (
                  <span data-on={i < p.stageIndex ? '' : undefined} data-current={i === p.stageIndex ? '' : undefined} />
                ))}
              </div>
            </div>
            <p class="pf-summary">{p.summary}</p>
            {a.steps.map((s, i) => (
              <div class:list={['pf-step', { 'pf-step--first': i === 0, 'pf-step--last': i === a.steps.length - 1 }]}>
                <p class="pf-step-k">
                  <span class="pf-dot" aria-hidden="true" />
                  {ADOPTION_PHASES[i]}
                </p>
                <p>{s}</p>
                {a.hardwareGates && i === 2 && (
                  <ol class="pf-gates" aria-label="Separate hardware gates">
                    {HARDWARE_GATES.map((g) => (
                      <li>{g.title}</li>
                    ))}
                  </ol>
                )}
              </div>
            ))}
            <p class="pf-not">
              <span>Boundary</span>
              {p.notThis}
            </p>
            <a class="link-arrow pf-link" href={p.href}>
              Explore {p.short} <ArrowRight size={16} aria-hidden="true" />
            </a>
          </article>
        );
      })
    }
  </div>
</div>

<style>
  .pf {
    display: grid;
    gap: clamp(28px, 3vw, 40px);
  }
  .pf-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    font-size: var(--fs-xs);
    color: var(--c-slate);
  }
  .pf-legend-k,
  .pf-kind {
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-slate);
  }
  .pf-key {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .pf-key i {
    width: 16px;
    height: 6px;
    margin-left: 4px;
    border-radius: 3px;
    background: var(--c-line);
  }
  .pf-key i.on {
    background: var(--c-ink-soft);
  }
  .pf-key i.cur {
    background: repeating-linear-gradient(90deg, var(--c-ink-soft) 0 4px, transparent 4px 6px);
  }

  .pf-grid {
    display: grid;
    gap: 20px;
  }
  .pf-col {
    display: grid;
    align-content: start;
    gap: 18px;
    padding: clamp(22px, 2.2vw, 30px);
    border: 1px solid var(--c-line);
    border-top: 3px solid var(--pc);
    border-radius: var(--r-m);
    background: var(--c-white);
  }
  @media (min-width: 980px) {
    .pf-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: repeat(9, auto);
      column-gap: 20px;
      row-gap: 0;
    }
    .pf-col {
      grid-row: span 9;
      grid-template-rows: subgrid;
      row-gap: 0;
    }
    .pf-col > * {
      padding-block: 9px;
    }
    .pf-col > .pf-head {
      padding-top: 0;
    }
    .pf-col > .pf-not {
      padding-top: 14px;
    }
  }
  .pf-head {
    display: grid;
    gap: 6px;
  }
  .pf-head .h3 {
    color: var(--c-ink);
  }
  .pf-stage {
    display: grid;
    gap: 10px;
    justify-items: start;
    align-content: start;
  }
  .pf-stage .meter {
    width: 100%;
  }
  .pf-stage .stage {
    max-width: 100%;
    white-space: normal;
    line-height: 1.35;
  }
  .pf-summary {
    font-size: var(--fs-small);
    color: var(--c-slate);
  }
  .pf-step {
    position: relative;
    display: grid;
    gap: 4px;
    align-content: start;
    padding-left: 26px;
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .pf-step::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 0;
    bottom: 0;
    width: 1.5px;
    background: color-mix(in srgb, var(--pc) 40%, transparent);
  }
  .pf-step:not(.pf-step--last)::before {
    bottom: -18px;
  }
  .pf-step--first::before {
    top: 1em;
  }
  .pf-step--last::before {
    bottom: auto;
    height: 1em;
  }
  @media (min-width: 980px) {
    .pf-step:not(.pf-step--last)::before {
      bottom: 0;
    }
    .pf-step--first::before {
      top: calc(9px + 0.7em);
    }
    .pf-step--last::before {
      height: calc(9px + 0.7em);
    }
  }
  .pf-step-k {
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pc-ink);
  }
  .pf-dot {
    position: absolute;
    left: 0;
    top: 0.85em;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--pc);
    background: var(--c-white);
  }
  @media (min-width: 980px) {
    .pf-dot {
      top: calc(9px + 0.2em);
    }
  }
  .pf-step--last .pf-dot {
    border-style: dashed;
  }
  .pf-gates {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 6px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: g;
  }
  .pf-gates li {
    counter-increment: g;
    padding: 3px 9px;
    border: 1px solid color-mix(in srgb, var(--pc) 45%, transparent);
    border-radius: var(--r-pill);
    font-family: var(--f-mono);
    font-size: 0.68rem;
    color: var(--pc-ink);
    background: var(--pc-bg);
  }
  .pf-gates li::before {
    content: counter(g, decimal-leading-zero) ' ';
    opacity: 0.7;
  }
  .pf-not {
    display: grid;
    gap: 4px;
    align-content: start;
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: var(--c-slate);
    border-top: 1px solid var(--c-line);
    padding-top: 14px;
  }
  .pf-not span {
    font-family: var(--f-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-ink-soft);
  }
  .pf-link {
    align-self: end;
  }
</style>
