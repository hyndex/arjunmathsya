---
import '@/styles/global.css';
import SiteHeader from '@/components/site/SiteHeader';
import Footer from '@/components/site/Footer.astro';
import { SITE } from '@/data/site';
import manropeUrl from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title: string; // page title without the brand suffix
  description: string;
  image?: string; // path under /public
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
}
const { title, description, image = '/og/mathsya-og.png', noindex = false, jsonLd, bodyClass = '' } = Astro.props;
// Builds emit file-format pages (index.html, investors.html), so normalise both `/index.html` and `*.html` to the route.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const fullTitle = path === '/' ? `${SITE.name} | ${title}` : `${title} | ${SITE.name}`;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: new URL('/', Astro.site).href,
  logo: new URL('/favicon.svg', Astro.site).href,
  description: SITE.description,
  address: { '@type': 'PostalAddress', addressLocality: 'Bengaluru', addressCountry: 'IN' },
};
const ld = [path === '/' ? org : null, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])].filter(Boolean);
---

<!doctype html>
<html lang="en" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f8fafc" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={manropeUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader client:idle path={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Legacy deep links (e.g. old shares of investors.html#milestones) → the matching new section.
      {
        const map: Record<string, Record<string, string>> = {
          '/': { journey: 'scene-surface', products: 'scene-ecosystem', benefits: 'scene-value', proof: 'after-story' },
          '/platform': { interfaces: 'integration' },
          '/battery-ai': { how: 'principle', benefits: 'outcomes', proof: 'first-proof' },
          '/pmg': { principle: 'workflows', deployment: 'runtime', pmg: 'workflows', validation: 'proof' },
          '/evo-core': { benefits: 'value' },
          '/investors': { investors: 'next-ask', partner: 'next-ask', milestones: 'proof', milestone: 'evidence', thesis: 'problem', entry: 'first-application', opportunity: 'value' },
        };
        const path = location.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
        const to = (map[path] || {})[location.hash.slice(1)];
        const el = to ? document.getElementById(to) : null;
        if (el) {
          history.replaceState(null, '', '#' + to);
          el.scrollIntoView();
        }
      }
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 1000;
    padding: 12px 18px;
    border-radius: var(--r-pill);
    background: var(--c-ink);
    color: var(--c-white);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-160%);
    transition: transform var(--dur-s) var(--ease-out);
  }
  .skip-link:focus {
    transform: none;
  }
  main:focus {
    outline: none;
  }
</style>
