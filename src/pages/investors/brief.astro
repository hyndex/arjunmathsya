---
import { ArrowLeft, ArrowRight, Download, Printer } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buttonVariants } from '@/components/ui/button';
import { GENERATIONS, PMG_POC } from '@/data/portfolio';
import { PRODUCTS } from '@/data/products';
import { BRIEF } from '@/data/investors';

const gens = [GENERATIONS.gen1, GENERATIONS.gen2, GENERATIONS.gen3];
const url = (path: string) => new URL(path, Astro.site).href;
const links = [
  { k: 'Website', href: url('/') },
  { k: 'Full investor narrative', href: url('/investors') },
  { k: 'Enquiry options', href: url('/contact') },
];
---

<BaseLayout
  title="Investor and Partner Brief"
  image="/og/og-investors.png"
  description="A printable brief on Mathsya: the opportunity, three products, benefits to evaluate, the first proof, the partnership sought and the founder."
>
  <div class="brief-page">
    <div class="brief-shell">
      <div class="brief-toolbar" data-print-hide>
        <a class="link-arrow" href="/investors"><ArrowLeft size={16} aria-hidden="true" /> Full investor narrative</a>
        <div class="brief-actions">
          <button type="button" class={buttonVariants({})} data-print>
            Print / save PDF <Printer aria-hidden="true" />
          </button>
          <a class={buttonVariants({ variant: 'secondary' })} href="/assets/Mathsya-Investor-Brief.md" download>
            Download text <Download aria-hidden="true" />
          </a>
        </div>
      </div>
      <script>
        document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
      </script>

      <article class="brief" aria-labelledby="brief-title">
        <header class="brief-head">
          <div class="brief-lockup">
            <span class="brief-mark" aria-hidden="true">
              <svg viewBox="0 0 48 48" width="30" height="30" focusable="false">
                <rect width="48" height="48" rx="13" fill="#185ADB"></rect>
                <path d="M10 32V16h5l9 11 9-11h5v16h-5V23l-9 10-9-10v9z" fill="#fff"></path>
              </svg>
            </span>
            <p class="brief-kicker"><span>Investor &amp; partner brief</span><span>{BRIEF.date}</span></p>
          </div>
          <h1 id="brief-title" class="brief-title">{BRIEF.title}</h1>
          <p class="brief-lead">{BRIEF.subtitle}</p>
          <dl class="brief-facts">
            {
              BRIEF.facts.map((f) => (
                <div>
                  <dt>{f.k}</dt>
                  <dd>{f.v}</dd>
                </div>
              ))
            }
          </dl>
        </header>

        <section class="brief-sec" aria-labelledby="b-opportunity">
          <h2 id="b-opportunity"><span>01</span>The opportunity</h2>
          <p class="brief-prose">{BRIEF.opportunity}</p>
        </section>

        <section class="brief-sec" aria-labelledby="b-products">
          <h2 id="b-products"><span>02</span>The products</h2>
          <div class="brief-products">
            {
              BRIEF.products.map((p) => (
                <section class={`brief-product brief-${p.product}`} aria-label={p.name}>
                  <p class="brief-k">{PRODUCTS[p.product].kind}</p>
                  <h3>{p.name}</h3>
                  <p>{p.body}</p>
                  <p class="brief-adopt">
                    <span>Potential commercial path</span>
                    {p.path}
                  </p>
                  <p class="brief-stage">{PRODUCTS[p.product].stage}</p>
                </section>
              ))
            }
          </div>
          <div class="brief-roadmap">
            <h3>Proposed Evo Core roadmap <span>no committed dates</span></h3>
            <ol class="brief-gens">
              {
                gens.map((g) => (
                  <li>
                    <span class="brief-gen-n">{g.short}</span>
                    <strong>{g.label}</strong>
                  </li>
                ))
              }
            </ol>
          </div>
        </section>

        <section class="brief-sec" aria-labelledby="b-benefits">
          <h2 id="b-benefits"><span>03</span>Benefits to evaluate</h2>
          <p class="brief-prose">{BRIEF.benefits}</p>
        </section>

        <section class="brief-sec" aria-labelledby="b-proof">
          <h2 id="b-proof"><span>04</span>The first proof</h2>
          <p class="brief-prose">{BRIEF.firstProof}</p>
          <ol class="brief-gates" aria-label="Proposed PMG software PoC gates">
            {
              PMG_POC.map((g) => (
                <li>
                  <span>{g.weeks}</span>
                  <strong>{g.title}</strong>
                </li>
              ))
            }
          </ol>
        </section>

        <section class="brief-sec brief-ask" aria-labelledby="b-ask">
          <h2 id="b-ask"><span>05</span>The partnership sought</h2>
          <p class="brief-prose">{BRIEF.partnership}</p>
        </section>

        <section class="brief-sec" aria-labelledby="b-founder">
          <h2 id="b-founder"><span>06</span>Founder background</h2>
          <p class="brief-prose">{BRIEF.founder}</p>
        </section>

        <footer class="brief-foot">
          <dl class="brief-links">
            {
              links.map((l) => (
                <div>
                  <dt>{l.k}</dt>
                  <dd>
                    <a href={l.href}>{l.href}</a>
                  </dd>
                </div>
              ))
            }
          </dl>
          <p class="brief-disclaimer">{BRIEF.stageNote}</p>
        </footer>
      </article>

      <p class="brief-next" data-print-hide>
        <a class="link-arrow" href="/investors">Explore the complete investor narrative <ArrowRight size={16} aria-hidden="true" /></a>
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .brief-page {
    padding-block: clamp(28px, 4vw, 56px) clamp(64px, 7vw, 120px);
    background: var(--c-pearl);
  }
  .brief-shell {
    width: min(100% - 2 * var(--gutter), 940px);
    margin-inline: auto;
  }
  .brief-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 24px;
    margin-bottom: 20px;
  }
  .brief-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .brief {
    padding: clamp(24px, 5.5vw, 68px);
    border: 1px solid var(--c-line);
    border-radius: var(--r-l);
    background: var(--c-white);
    box-shadow: var(--sh-2);
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  /* Head */
  .brief-lockup {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    padding-bottom: 18px;
    border-bottom: 2px solid var(--c-ink);
  }
  .brief-mark svg {
    display: block;
  }
  .brief-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-slate);
  }
  .brief-kicker span:first-child {
    color: var(--c-cobalt-ink);
  }
  .brief-title {
    margin-top: clamp(24px, 3.5vw, 40px);
    font-size: clamp(2.1rem, 1.4rem + 3vw, 3.6rem);
    font-weight: 750;
    line-height: 1.02;
    letter-spacing: -0.045em;
  }
  .brief-lead {
    margin-top: 14px;
    max-width: 44ch;
    font-family: var(--f-display);
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--c-cobalt-ink);
  }
  .brief-facts {
    display: grid;
    gap: 0 28px;
    margin: clamp(22px, 3vw, 34px) 0 0;
  }
  .brief-facts > div {
    display: grid;
    gap: 4px;
    padding: 12px 0;
    border-top: 1px solid var(--c-line-strong);
  }
  .brief-facts dt,
  .brief-links dt {
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-slate);
  }
  .brief-facts dd {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 650;
    line-height: 1.4;
  }
  @media (min-width: 640px) {
    .brief-facts {
      grid-template-columns: 1fr 1.4fr;
    }
  }

  /* Sections */
  .brief-sec {
    margin-top: clamp(26px, 3.5vw, 40px);
    padding-top: clamp(20px, 2.6vw, 28px);
    border-top: 1px solid var(--c-line);
  }
  .brief-sec h2 {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 12px;
    font-size: clamp(1.2rem, 1.08rem + 0.5vw, 1.45rem);
    font-weight: 720;
    letter-spacing: -0.02em;
  }
  .brief-sec h2 span {
    font-family: var(--f-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--c-cobalt-ink);
  }
  .brief-sec h3 {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .brief-prose {
    max-width: 72ch;
    color: var(--c-ink-soft);
  }

  .brief-products {
    display: grid;
    gap: 22px;
  }
  @media (min-width: 760px) {
    .brief-products {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 26px;
    }
  }
  .brief-product {
    display: grid;
    gap: 8px;
    align-content: start;
    padding-top: 14px;
    border-top: 3px solid var(--bp);
    color: var(--c-ink-soft);
  }
  .brief-battery {
    --bp: var(--p-battery);
    --bp-ink: var(--p-battery-ink);
  }
  .brief-pmg {
    --bp: var(--p-pmg);
    --bp-ink: var(--p-pmg-ink);
  }
  .brief-evo {
    --bp: var(--p-evo);
    --bp-ink: var(--p-evo-ink);
  }
  .brief-k {
    font-family: var(--f-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bp-ink);
  }
  .brief-product h3 {
    color: var(--c-ink);
  }
  .brief-adopt {
    display: grid;
    gap: 2px;
    margin-top: 4px;
    color: var(--c-ink);
  }
  .brief-adopt span,
  .brief-roadmap h3 span {
    font-family: var(--f-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-slate);
  }
  .brief-stage {
    font-family: var(--f-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-slate);
  }
  .brief-stage::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--bp);
  }

  /* Compact roadmaps: Evo Core generations, PMG PoC gates */
  .brief-roadmap {
    display: grid;
    gap: 10px;
    margin-top: 22px;
  }
  .brief-roadmap h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
  }
  .brief-gens,
  .brief-gates {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 560px) {
    .brief-gens {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .brief-gates {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .brief-gens li,
  .brief-gates li {
    display: grid;
    gap: 2px;
    padding: 10px 12px;
    border-radius: var(--r-s);
    line-height: 1.35;
  }
  .brief-gens li {
    border: 1px solid color-mix(in srgb, var(--p-evo) 30%, var(--c-line));
    background: var(--c-ivory);
  }
  .brief-gates {
    margin-top: 14px;
  }
  .brief-gates li {
    border: 1px solid var(--c-cobalt-soft);
    background: var(--c-ice);
  }
  .brief-gen-n,
  .brief-gates span {
    font-family: var(--f-mono);
    font-size: 0.68rem;
  }
  .brief-gen-n {
    color: var(--c-tangerine-ink);
  }
  .brief-gates span {
    color: var(--c-cobalt-ink);
  }
  .brief-gens strong,
  .brief-gates strong {
    font-family: var(--f-display);
    font-size: 0.92rem;
  }

  .brief-ask .brief-prose {
    padding: 14px 18px;
    border-left: 3px solid var(--c-cobalt);
    background: var(--c-ice);
    border-radius: 0 var(--r-s) var(--r-s) 0;
    color: var(--c-ink);
  }

  .brief-foot {
    display: grid;
    gap: 16px;
    margin-top: clamp(28px, 4vw, 44px);
    padding-top: 18px;
    border-top: 2px solid var(--c-ink);
  }
  .brief-links {
    display: grid;
    gap: 10px 24px;
    margin: 0;
  }
  @media (min-width: 720px) {
    .brief-links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .brief-links dd {
    margin: 2px 0 0;
    font-size: var(--fs-xs);
    overflow-wrap: anywhere;
  }
  .brief-disclaimer {
    font-size: var(--fs-xs);
    color: var(--c-slate);
  }
  .brief-next {
    margin-top: 24px;
  }
</style>

<style is:global>
  /* Print / save PDF: two to three readable A4 pages, no site chrome or controls. */
  @media print {
    @page {
      size: A4;
      margin: 16mm 16mm 18mm;
    }
    html,
    body {
      background: #fff !important;
    }
    .site-header,
    .site-footer,
    .skip-link,
    [data-print-hide] {
      display: none !important;
    }
    * {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .brief-page {
      padding: 0 !important;
      background: #fff !important;
    }
    .brief-shell {
      width: auto !important;
    }
    .brief {
      padding: 0 !important;
      border: 0 !important;
      border-radius: 0 !important;
      box-shadow: none !important;
      font-size: 10.5pt !important;
      line-height: 1.5 !important;
    }
    .brief-title {
      margin-top: 9mm !important;
      font-size: 30pt !important;
    }
    .brief-lead {
      font-size: 14pt !important;
    }
    .brief-sec {
      margin-top: 7mm !important;
      padding-top: 5mm !important;
    }
    .brief-sec h2 {
      font-size: 14pt !important;
      break-after: avoid;
    }
    .brief h3 {
      font-size: 11.5pt !important;
      break-after: avoid;
    }
    .brief-facts {
      grid-template-columns: 1fr 1.4fr !important;
    }
    /* Full-width product blocks: each one stays whole, and page 1 is not left half empty. */
    .brief-products {
      grid-template-columns: 1fr !important;
      gap: 5mm !important;
    }
    .brief-product {
      padding-top: 3mm !important;
    }
    .brief-gens {
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }
    .brief-gates {
      grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    }
    .brief-links {
      grid-template-columns: 1fr !important;
      gap: 2mm !important;
    }
    .brief-links > div {
      display: flex;
      gap: 4mm;
      align-items: baseline;
    }
    .brief-links dt {
      flex: 0 0 48mm;
    }
    .brief-product,
    .brief-roadmap,
    .brief-gates,
    .brief-facts > div,
    .brief-ask,
    .brief-foot {
      break-inside: avoid;
    }
    .brief-prose {
      orphans: 3;
      widows: 3;
    }
    .brief a {
      color: inherit !important;
      text-decoration: none !important;
    }
  }
</style>
