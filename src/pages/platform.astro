---
import { ArrowDown } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import PageNav from '@/components/ui/PageNav.astro';
import { buttonVariants } from '@/components/ui/button';
import ArchitectureDiagram from '@/components/platform/ArchitectureDiagram';
import IntegrationStepper from '@/components/platform/IntegrationStepper';
import BenefitFlow from '@/components/platform/BenefitFlow';
import VehiclePlan from '@/components/platform/VehiclePlan.astro';
import { contactHref } from '@/data/site';
import { MEASURES } from '@/data/portfolio';
import {
  PLATFORM_META,
  PLATFORM_HERO,
  LEVELS,
  ARCH_NOTES,
  ROLE_ROWS,
  ROLES_CAPTION,
  ADOPTION_LEAD,
  ADOPTION_ROUTES,
  ADOPTION_EXPANSION,
  DEPLOYMENT_LOCATIONS,
  DEPLOYMENT_INTERFACES,
  RESPONSIBILITIES,
  HW_SW_COLS,
  HW_SW_ROWS,
  BENEFITS_INTRO,
  PRINCIPLES,
  INTEGRATION_TERMS,
  PLATFORM_CTA,
} from '@/data/platform';

const nav = [
  { id: 'architecture', label: 'Architecture' },
  { id: 'integration', label: 'Integration path' },
  { id: 'roles', label: 'Product roles' },
  { id: 'adoption', label: 'Adoption' },
  { id: 'deployment', label: 'Deployment' },
  { id: 'benefits', label: 'Benefits' },
  { id: 'principles', label: 'Principles' },
];
const chip = (id: string) => `pchip pchip--${id}`;
const mark = { yes: 'Yes', no: 'No', optional: 'Optional' } as const;
// Product names inside the level descriptions link to their detail pages.
const PRODUCT_LINKS: Record<string, string> = { 'Battery & Charging AI': '/battery-ai', 'Evo Core': '/evo-core', PMG: '/pmg' };
const linked = (text: string) => text.split(/(Battery & Charging AI|Evo Core|PMG)/).map((part) => ({ part, href: PRODUCT_LINKS[part] }));
---

<BaseLayout title={PLATFORM_META.title} description={PLATFORM_META.description}>
  <!-- ============ Hero ============ -->
  <section class="pf-hero" aria-labelledby="pf-title">
    <div class="container--wide pf-hero-inner">
      <p class="eyebrow">{PLATFORM_HERO.eyebrow}</p>
      <h1 id="pf-title" class="h1 pf-title">
        <span class="soft-break">{PLATFORM_HERO.title[0]}</span>
        <span class="soft-break pf-title-2">{PLATFORM_HERO.title[1]}</span>
      </h1>
      <div class="pf-hero-foot">
        <p class="lead">{PLATFORM_HERO.lead}</p>
        <div class="pf-hero-actions">
          <div class="btn-row">
            <a class={buttonVariants({ size: 'lg' })} href="#architecture">Explore the architecture <ArrowDown aria-hidden="true" /></a>
            <a class={buttonVariants({ variant: 'secondary', size: 'lg' })} href="/explore">Explore the vehicle</a>
          </div>
          <p class="stage stage--pmg pf-stage">{PLATFORM_HERO.stage}</p>
        </div>
      </div>
    </div>
  </section>

  <PageNav items={nav} label="Platform sections" />

  <!-- ============ 01 Architecture (signature) ============ -->
  <section id="architecture" class="section tone-ice" aria-labelledby="architecture-title">
    <div class="container--wide">
      <div class="section-head section-head--split">
        <div class="stack" style="--stack:18px">
          <p class="eyebrow">One portfolio / three levels</p>
          <h2 id="architecture-title" class="h2">Three levels, joined by approved interfaces</h2>
        </div>
        <p class="lead">
          The lines are approved data and recommendation interfaces, not physical power paths. Non-Mathsya systems are shown as reference systems. Select a product to see what
          it exchanges, and with whom.
        </p>
      </div>
      <ArchitectureDiagram client:visible>
        <ol class="levels">
          {
            LEVELS.map((l) => (
              <li class="level">
                <p class="level-k">
                  <span class="level-n">{l.n}</span>
                  {l.title}
                  {'note' in l && <span class="level-tag">{l.note}</span>}
                </p>
                <p class="level-body">{linked(l.body).map(({ part, href }) => (href ? <a href={href}>{part}</a> : part))}</p>
              </li>
            ))
          }
        </ol>
      </ArchitectureDiagram>
      <dl class="arch-notes">
        <div>
          <dt>Adoption</dt>
          <dd>{ARCH_NOTES.adoption}</dd>
        </div>
        <div>
          <dt>Engineering boundary</dt>
          <dd>{ARCH_NOTES.boundary}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ============ 02 Integration path ============ -->
  <section id="integration" class="section tone-white" aria-labelledby="integration-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="stack" style="--stack:18px">
          <p class="eyebrow">How integration works</p>
          <h2 id="integration-title" class="h2">Four steps from a module signal to a verified outcome</h2>
        </div>
        <p class="lead">Connect through interfaces and keep ownership clear. Step through what each stage uses, retains or requests, and where it happens.</p>
      </div>
      <IntegrationStepper client:visible />
    </div>
  </section>

  <!-- ============ 03 Product roles ============ -->
  <section id="roles" class="section tone-pearl" aria-labelledby="roles-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">A clear role for each product</p>
        <h2 id="roles-title" class="h2">Hardware, embedded AI and vehicle software</h2>
        <p class="lead">Four proposed roles, each with its own place, its own adopters and its own route to revenue.</p>
      </div>
      <div class="table-wrap" tabindex="0" role="region" aria-labelledby="roles-caption">
        <table class="table roles-table">
          <caption id="roles-caption">{ROLES_CAPTION}</caption>
          <thead>
            <tr>
              <th scope="col">Product</th>
              <th scope="col">What it does</th>
              <th scope="col">Where it runs</th>
              <th scope="col">Who could adopt</th>
              <th scope="col">Proposed commercial path</th>
            </tr>
          </thead>
          <tbody>
            {
              ROLE_ROWS.map((r) => (
                <tr>
                  <th scope="row">
                    <span class={chip(r.id)}>{r.product}</span>
                  </th>
                  <td>{r.what}</td>
                  <td>{r.where}</td>
                  <td>{r.who}</td>
                  <td>{r.path}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============ 04 Independent adoption ============ -->
  <section id="adoption" class="section tone-white" aria-labelledby="adoption-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="stack" style="--stack:18px">
          <p class="eyebrow">Independent adoption</p>
          <h2 id="adoption-title" class="h2">Every product has its own way in</h2>
        </div>
        <p class="lead">{ADOPTION_LEAD}</p>
      </div>
      <div class="routes">
        <ol class="routes-list">
          {
            ADOPTION_ROUTES.map((r, i) => (
              <li class="route" style={`--route:var(--p-${r.id})`}>
                <div class="route-start">
                  <span class="route-n">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="route-title">{r.start}</h3>
                  <p class="route-who">{r.who}</p>
                </div>
                <dl class="route-steps">
                  <div class="route-step">
                    <dt>First proof</dt>
                    <dd>{r.first}</dd>
                  </div>
                  <div class="route-step route-step--later">
                    <dt>Connect later · optional</dt>
                    <dd>{r.later}</dd>
                  </div>
                </dl>
              </li>
            ))
          }
        </ol>
        <aside class="routes-merge" aria-label="Expansion path">
          <p class="routes-merge-k">Expansion path</p>
          <p class="routes-merge-title">{ADOPTION_EXPANSION.title}</p>
          <p class="routes-merge-body">{ADOPTION_EXPANSION.body}</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- ============ 05 Deployment ============ -->
  <section id="deployment" class="section tone-ice" aria-labelledby="deployment-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Deployment</p>
        <h2 id="deployment-title" class="h2">Where each part runs</h2>
        <p class="lead">Battery & Charging AI and PMG are software on suitable vehicle compute; Evo Core is power hardware with its own embedded software; the cloud sits outside the vehicle and stays optional.</p>
      </div>

      <div class="deploy">
        <div class="deploy-figure">
          <VehiclePlan />
        </div>
        <div class="deploy-main">
          <ol class="deploy-list">
            {
              DEPLOYMENT_LOCATIONS.map((l) => (
                <li class="deploy-item" data-id={l.id}>
                  <span class="deploy-n" aria-hidden="true">{l.n}</span>
                  <div class="deploy-copy">
                    <p class="deploy-place">
                      <span class="visually-hidden">Location {l.n}: </span>
                      {l.place}
                    </p>
                    <h3 class="deploy-runs">{l.runs}</h3>
                    <p class="deploy-detail">{l.detail}</p>
                  </div>
                </li>
              ))
            }
          </ol>

          <div class="deploy-ifaces">
            <h3 class="deploy-sub">Approved interfaces</h3>
            <dl>
              {
                DEPLOYMENT_INTERFACES.map((it) => (
                  <div>
                    <dt>{it.label}</dt>
                    <dd>{it.text}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </div>

      <div class="resp">
        <div class="resp-col">
          <h3 class="resp-title">{RESPONSIBILITIES.local.label}</h3>
          <ul>{RESPONSIBILITIES.local.items.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div class="resp-boundary" aria-hidden="true"><span>Vehicle boundary</span></div>
        <div class="resp-col resp-col--cloud">
          <h3 class="resp-title">{RESPONSIBILITIES.cloud.label}</h3>
          <ul>{RESPONSIBILITIES.cloud.items.map((t) => <li>{t}</li>)}</ul>
        </div>
      </div>

      <div class="table-wrap hwsw-wrap" tabindex="0" role="region" aria-labelledby="hwsw-caption">
        <table class="table hwsw">
          <caption id="hwsw-caption">Hardware and software separation. PMG cloud services are optional and separate from the PMG vehicle runtime.</caption>
          <thead>
            <tr>
              <th scope="col">Product</th>
              {HW_SW_COLS.map((c) => <th scope="col">{c}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              HW_SW_ROWS.map((r) => (
                <tr>
                  <th scope="row">
                    <span class={chip(r.id)}>{r.product}</span>
                    <span class="hwsw-summary">{r.summary}</span>
                  </th>
                  {r.cells.map((c) => (
                    <td data-v={c}>
                      <span class="hwsw-mark" aria-hidden="true" />
                      <span class="hwsw-text">{mark[c]}</span>
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============ 06 Benefits and measures ============ -->
  <section id="benefits" class="section tone-white" aria-labelledby="benefits-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="stack" style="--stack:18px">
          <p class="eyebrow">Benefits and measures</p>
          <h2 id="benefits-title" class="h2">{MEASURES.title}</h2>
        </div>
        <p class="lead">{MEASURES.lead}</p>
      </div>
      <div class="table-wrap" tabindex="0" role="region" aria-labelledby="measures-cap">
        <table class="table measures-table">
          <caption id="measures-cap">Benefits to evaluate in a first proof, each with its measures. No result is claimed before the comparison exists.</caption>
          <thead>
            <tr>
              <th scope="col">Application</th>
              <th scope="col">Customer and OEM value to evaluate</th>
              <th scope="col">Measures for the first proof</th>
            </tr>
          </thead>
          <tbody>
            {
              MEASURES.rows.map((r) => (
                <tr>
                  <th scope="row">{r.app}</th>
                  <td>{r.value}</td>
                  <td>{r.measures}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="note measures-note">{MEASURES.note}</p>

      <div class="benefit-flow-head">
        <h3 class="h3">Follow one decision</h3>
        <p class="muted">{BENEFITS_INTRO}</p>
      </div>
      <BenefitFlow client:visible />
    </div>
  </section>

  <!-- ============ 07 Principles, validation, integration ============ -->
  <section id="principles" class="section tone-pearl" aria-labelledby="principles-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Engineering principles</p>
        <h2 id="principles-title" class="h2">Useful AI needs defined authority</h2>
      </div>

      <ol class="principles">
        {
          PRINCIPLES.map((p) => (
            <li class="principle">
              <p class="principle-k">
                <span class="principle-n">{p.n}</span>
                {p.label}
              </p>
              <h3 class="principle-title">{p.title}</h3>
              <p class="principle-body">{p.body}</p>
              <div class="principle-req">
                <p class="principle-req-k">Validation requirement</p>
                <p>{p.require}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="terms">
        <div class="terms-head">
          <p class="terms-eyebrow">Integration & commercial considerations</p>
          <h3 class="h3">{INTEGRATION_TERMS.title}</h3>
          <p class="terms-body">{INTEGRATION_TERMS.body}</p>
        </div>
        <div class="terms-sheet">
          <div class="terms-group">
            <p class="terms-k">Set during the reference program</p>
            <ul>{INTEGRATION_TERMS.reference.map((t) => <li>{t}</li>)}</ul>
          </div>
          <div class="terms-group terms-group--owner">
            <p class="terms-k">Needs an agreed owner</p>
            <ul>{INTEGRATION_TERMS.owner.map((t) => <li>{t}</li>)}</ul>
          </div>
          <p class="terms-commercial">{INTEGRATION_TERMS.commercial}</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title={PLATFORM_CTA.title}
    body={PLATFORM_CTA.body}
    primary={{ label: 'Discuss a pilot', href: contactHref('oem-pilot') }}
    secondary={{ label: 'Explore the vehicle', href: '/explore' }}
  />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .pf-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(48px, 7vw, 112px) 0 clamp(56px, 7vw, 104px);
    background: linear-gradient(180deg, var(--c-ice) 0%, #f1f7ff 55%, var(--c-pearl) 100%);
  }
  .pf-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--c-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--c-grid) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(180deg, #000 0%, transparent 85%);
    pointer-events: none;
  }
  .pf-hero-inner {
    position: relative;
  }
  .pf-title {
    margin-top: 22px;
  }
  .pf-title-2 {
    color: var(--c-cobalt-ink);
  }
  .pf-hero-foot {
    display: grid;
    gap: 32px;
    margin-top: clamp(36px, 5vw, 64px);
  }
  .pf-hero-foot .lead {
    max-width: 62ch;
  }
  .pf-hero-actions {
    display: grid;
    gap: 18px;
    align-content: start;
  }
  .pf-stage {
    justify-self: start;
    white-space: normal;
    border-radius: var(--r-s);
    line-height: 1.4;
  }
  @media (min-width: 768px) {
    .pf-hero-foot {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: start;
      gap: 32px clamp(32px, 4vw, 72px);
    }
  }

  /* ---------- Three levels (inside the architecture diagram's head slot) ---------- */
  .levels {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--c-ink);
  }
  .level {
    display: grid;
    gap: 6px;
    padding: 16px 0;
    border-bottom: 1px solid var(--c-line-strong);
  }
  .level-k {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    font-family: var(--f-display);
    font-size: 1.12rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .level-n {
    font-family: var(--f-mono);
    font-size: 0.74rem;
    font-weight: 500;
    color: var(--c-cobalt-ink);
  }
  .level-tag {
    padding: 2px 9px;
    border: 1px dashed var(--c-slate-2);
    border-radius: var(--r-pill);
    font-family: var(--f-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-slate);
  }
  .level-body {
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--c-ink-soft);
  }
  .level-body a {
    font-weight: 650;
    color: var(--c-cobalt-ink);
  }
  .arch-notes {
    display: grid;
    gap: 16px 40px;
    margin: 28px 0 0;
  }
  .arch-notes > div {
    display: grid;
    gap: 6px;
    padding: 16px 18px;
    border-left: 3px solid var(--c-ink);
    background: var(--c-white);
    border-radius: 0 var(--r-s) var(--r-s) 0;
  }
  .arch-notes dt {
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-slate);
  }
  .arch-notes dd {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--c-ink);
  }
  @media (min-width: 900px) {
    .arch-notes {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ---------- Benefits and measures ---------- */
  .measures-table {
    min-width: 760px;
  }
  .measures-table tbody th {
    min-width: 150px;
  }
  .measures-note {
    margin-top: 16px;
  }
  .benefit-flow-head {
    display: grid;
    gap: 8px;
    margin: clamp(48px, 6vw, 80px) 0 24px;
    max-width: 62ch;
  }

  /* ---------- Product chips used in tables ---------- */
  .pchip--cloud::before {
    background: transparent;
    border: 1.5px dashed var(--c-slate-2);
  }

  /* ---------- Roles table ---------- */
  .roles-table {
    min-width: 980px;
  }
  .roles-table tbody th {
    min-width: 200px;
  }

  /* ---------- Adoption routes ---------- */
  .routes {
    display: grid;
    gap: 28px;
  }
  .routes-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--c-line-strong);
  }
  .route {
    position: relative;
    display: grid;
    gap: 16px;
    padding: 26px 0 26px 20px;
    border-bottom: 1px solid var(--c-line-strong);
  }
  .route::before {
    content: '';
    position: absolute;
    top: 26px;
    bottom: 26px;
    left: 0;
    width: 4px;
    border-radius: 2px;
    background: var(--route);
  }
  .route-start {
    display: grid;
    gap: 6px;
    align-content: start;
  }
  .route-n {
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--c-slate);
  }
  .route-title {
    font-size: 1.22rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }
  .route-who {
    font-size: var(--fs-small);
    color: var(--c-slate);
  }
  .route-steps {
    display: grid;
    gap: 14px;
    margin: 0;
  }
  .route-step dt {
    margin-bottom: 4px;
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-ink-soft);
  }
  .route-step dd {
    margin: 0;
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--c-ink-soft);
  }
  .route-step--later {
    padding-left: 14px;
    border-left: 2px dashed var(--c-slate-2);
  }
  .routes-merge {
    display: grid;
    gap: 8px;
    align-content: center;
    padding: 22px 24px;
    border: 1.5px dashed var(--c-slate-2);
    border-radius: var(--r-l);
    background: var(--c-pearl);
  }
  .routes-merge-k {
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-slate);
  }
  .routes-merge-title {
    font-family: var(--f-display);
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .routes-merge-body {
    font-size: var(--fs-small);
    color: var(--c-slate);
  }
  @media (min-width: 900px) {
    .route {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 2fr);
      gap: 32px;
      padding-left: 28px;
    }
    .route-steps {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 32px;
    }
  }
  @media (min-width: 1100px) {
    .routes {
      grid-template-columns: minmax(0, 1fr) 250px;
      gap: 0 64px;
      align-items: center;
    }
    /* each route reaches the shared expansion path with a dashed lead-out */
    .route::after {
      content: '';
      position: absolute;
      top: 50%;
      right: -64px;
      width: 64px;
      border-top: 2px dashed var(--route);
    }
    .routes-merge {
      min-height: 72%;
    }
  }

  /* ---------- Deployment ---------- */
  .deploy {
    display: grid;
    gap: 40px;
  }
  .deploy-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--c-line-strong);
  }
  .deploy-item {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--c-line-strong);
  }
  .deploy-n {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid var(--dn, var(--c-ink));
    background: var(--c-white);
