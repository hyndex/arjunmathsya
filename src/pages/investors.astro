---
import { ArrowDown, ArrowRight, Download, FileText } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import PageNav from '@/components/ui/PageNav.astro';
import { buttonVariants } from '@/components/ui/button';
import Chapter from '@/components/investors/Chapter.astro';
import ValueFlow from '@/components/investors/ValueFlow.astro';
import PortfolioCompare from '@/components/investors/PortfolioCompare.astro';
import ProofTimeline from '@/components/investors/ProofTimeline.astro';
import MarketMap from '@/components/investors/MarketMap';
import AudienceTabs from '@/components/investors/AudienceTabs';
import '@/components/investors/investors.css';
import { contactHref } from '@/data/site';
import {
  AT_A_GLANCE,
  BRIEF,
  BUSINESS,
  CHAPTERS,
  COMMERCIAL,
  COMMERCIAL_NOTE,
  ECONOMICS,
  ENTRY,
  FOUNDER,
  HERO,
  MILESTONE,
  OPEN_NUMBERS,
  OPPORTUNITY,
  PARTNER,
  PORTFOLIO,
  PROBLEM,
  PROOF,
  RESOURCES,
  THESIS,
  kb,
} from '@/data/investors';

const nav = [...CHAPTERS.map((c) => ({ id: c.id, label: c.nav })), { id: 'resources', label: 'Resources' }];
const chapter = (id: string) => CHAPTERS.find((c) => c.id === id)!;
const oemPaths = COMMERCIAL.filter((c) => c.buyers.includes('oem')).length;
const pchip = (tone: string) => (tone === 'neutral' ? 'pchip' : `pchip pchip--${tone}`);
---

<BaseLayout
  title="Investors & strategic partnerships"
  description="Mathsya’s investor narrative: thesis, product portfolio, proposed business model, separate software and hardware proof paths, and the partnership sought."
>
  <!-- Hero -->
  <section class="inv-hero tone-white" aria-labelledby="inv-title">
    <div class="container">
      <p class="eyebrow">{HERO.eyebrow}</p>
      <h1 id="inv-title" class="h1 inv-hero-title">
        {HERO.title[0]}<span class="soft-break inv-hero-l2">{HERO.title[1]}</span>
      </h1>
      <div class="inv-hero-grid">
        <div class="inv-hero-copy">
          <p class="lead">{HERO.lead}</p>
          <div class="inv-actions">
            <a class={buttonVariants({ size: 'lg' })} href="#thesis">Start with the thesis <ArrowDown aria-hidden="true" /></a>
            <a class={buttonVariants({ variant: 'secondary', size: 'lg' })} href="/investors/brief">Read the printable brief</a>
          </div>
          <p class="inv-hero-stage"><span class="stage stage--pmg">Current stage</span> {HERO.stage}</p>
        </div>

        <aside class="inv-glance" aria-labelledby="glance-title">
          <div class="inv-glance-head">
            <h2 id="glance-title" class="inv-glance-title">At a glance</h2>
            <span>{BRIEF.date}</span>
          </div>
          <dl>
            {
              AT_A_GLANCE.map((f) => (
                <div>
                  <dt>{f.k}</dt>
                  <dd>{f.v}</dd>
                </div>
              ))
            }
          </dl>
          <p class="inv-glance-legend">
            <span class="inv-meter" aria-hidden="true"><i data-on></i><i data-on></i><i></i></span>
            <span>Each chapter names its open evidence: claim proposed, evidence defined, not yet established.</span>
          </p>
        </aside>
      </div>
    </div>
  </section>

  <PageNav items={nav} label="Investor narrative chapters" />

  <!-- 01 Thesis -->
  <Chapter id="thesis" title={THESIS.title} lead={THESIS.lead}>
    <div class="thesis">
      <div class="thesis-copy">
        <p class="thesis-standfirst">{THESIS.statement}</p>
        <p class="muted">{THESIS.pathsIntro}</p>
      </div>
      <div class="thesis-paths">
        <h3 class="thesis-paths-title">{THESIS.pathsTitle}</h3>
        <ol class="thesis-list">
          {
            THESIS.paths.map((p, i) => (
              <li class={`inv-pc-${p.product}`}>
                <span class="thesis-mark" aria-hidden="true" />
                <p class="thesis-k">
                  {String(i + 1).padStart(2, '0')} · {p.k}
                </p>
                <h4 class="h4">{p.title}</h4>
                <p>{p.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </Chapter>

  <!-- 02 Problem -->
  <Chapter id="problem" title={PROBLEM.title} lead={PROBLEM.lead} tone="pearl">
    <ol class="stations" aria-label="From module signal to decision and evidence">
      {
        PROBLEM.stations.map((s, i) => (
          <li class:list={['station', { 'is-gap': s.gap }]}>
            <span class="station-n" aria-hidden="true" />
            <p class="station-k">
              {String(i + 1).padStart(2, '0')} · {s.k}
            </p>
            {s.gap && <p class="station-tag">{PROBLEM.gapLabel}</p>}
            <p class="station-body">{s.body}</p>
          </li>
        ))
      }
    </ol>
    <div class="problem-foot">
      <div class="firstcases">
        <p class="label-k">First issues to test</p>
        <ul>
          {PROBLEM.firstCases.map((c) => <li>{c}</li>)}
        </ul>
      </div>
      <p class="note">{PROBLEM.baselineNote}</p>
    </div>
  </Chapter>

  <!-- 03 Opportunity -->
  <Chapter id="opportunity" title={OPPORTUNITY.title} lead={OPPORTUNITY.lead}>
    <ValueFlow />
    <div class="outcomes">
      <h3 class="outcomes-title">Outcomes to measure across the portfolio</h3>
      {
        [OPPORTUNITY.outcomes.customer, OPPORTUNITY.outcomes.oem].map((o) => (
          <section class="outcome" aria-label={o.title}>
            <h4 class="h4">{o.title}</h4>
            <p>{o.body}</p>
            <p class="outcome-measure">
              <span>Measure</span>
              {o.measure}
            </p>
          </section>
        ))
      }
    </div>
    <p class="note">{OPPORTUNITY.note}</p>
  </Chapter>

  <!-- 04 Portfolio -->
  <Chapter id="portfolio" title={PORTFOLIO.title} lead={PORTFOLIO.lead} tone="pearl">
    <PortfolioCompare />
  </Chapter>

  <!-- 05 Entry strategy -->
  <Chapter id="entry" title={ENTRY.title} lead={ENTRY.lead}>
    <ol class="stairs" aria-label="Four steps of the first wedge">
      {
        ENTRY.steps.map((s, i) => (
          <li style={`--i:${i}`}>
            <p class="stairs-commit">{s.commit}</p>
            <p class="stairs-n">{s.n}</p>
            <h3 class="h4">{s.title}</h3>
            <p class="stairs-body">{s.body}</p>
          </li>
        ))
      }
    </ol>
    <p class="stairs-rule">{ENTRY.rule}</p>
  </Chapter>

  <!-- 06 Business model -->
  <Chapter id="business" title={BUSINESS.title} lead={BUSINESS.lead} tone="ice">
    <div class="biz">
      <div class="biz-intro">
        <h3 class="h3">Trace an offering to its market</h3>
        <p>
          Select an offering to follow its potential buyer, paid entry and expansion. OEMs appear in {oemPaths} of the {COMMERCIAL.length} proposed paths:
          one relationship could carry several products, provided each earns its own proof.
        </p>
      </div>
      <MarketMap client:visible />

      <div class="table-wrap" tabindex="0" role="region" aria-labelledby="matrix-cap">
        <table class="table biz-table">
          <caption id="matrix-cap">{COMMERCIAL_NOTE}</caption>
          <thead>
            <tr>
              <th scope="col">Offering</th>
              <th scope="col">Potential buyer</th>
              <th scope="col">Paid entry</th>
              <th scope="col">Expansion</th>
            </tr>
          </thead>
          <tbody>
            {
              COMMERCIAL.map((c) => (
                <tr>
                  <th scope="row">
                    <span class={pchip(c.tone)} style={c.tone === 'neutral' ? '--pchip: var(--c-slate-2)' : undefined}>
                      {c.offering}
                    </span>
                  </th>
                  <td>{c.buyer}</td>
                  <td>{c.entry}</td>
                  <td>
                    <span class="biz-arrow" aria-hidden="true">→</span> {c.expansion}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <section class="econ" aria-labelledby="econ-title">
        <div class="econ-head">
          <p class="label-k">Economics to validate</p>
          <h3 id="econ-title" class="h3">{ECONOMICS.title}</h3>
        </div>
        <ol class="eq" aria-label="Net value formula">
          {
            ECONOMICS.plus.map((t, i) => (
              <li class="eq-term eq-term--plus">
                {i > 0 && (
                  <span class="eq-op">
                    <span aria-hidden="true">+</span>
                    <span class="visually-hidden">plus</span>
                  </span>
                )}
                <span class="eq-box">{t}</span>
              </li>
            ))
          }
          <li class="eq-term eq-term--minus">
            <span class="eq-op"><span aria-hidden="true">−</span><span class="visually-hidden">minus</span></span>
            <span class="eq-box">{ECONOMICS.minus}</span>
          </li>
          <li class="eq-term eq-term--result">
            <span class="eq-op"><span aria-hidden="true">=</span><span class="visually-hidden">equals</span></span>
            <span class="eq-box">{ECONOMICS.result}</span>
          </li>
        </ol>
        <p class="econ-note">{ECONOMICS.note}</p>
      </section>

      <section class="opennum" aria-labelledby="opennum-title">
        <div class="opennum-head">
          <h3 id="opennum-title" class="h3">The numbers the next proof must establish</h3>
          <p>
            Buyer interviews, addressable reference programs, pricing, unit economics, TAM/SAM/SOM and the funding ask require a sourced, bottom-up case. They
            remain open here rather than being presented as traction.
          </p>
        </div>
        <dl class="opennum-grid">
          {
            OPEN_NUMBERS.map((n) => (
              <div class="opennum-cell">
                <dt>{n.k}</dt>
                <dd class="opennum-val">
                  <span aria-hidden="true">—</span>
                  <span class="visually-hidden">Not yet established.</span>
                </dd>
                <dd class="opennum-how">{n.how}</dd>
                <dd class="opennum-status">Open</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>
  </Chapter>

  <!-- 07 Proof roadmap -->
  <Chapter id="proof" title={PROOF.title} lead={PROOF.lead}>
    <ProofTimeline />
  </Chapter>

  <!-- 08 Investment & partnership -->
  <Chapter id="partner" title={PARTNER.title} lead={PARTNER.lead} tone="pearl">
    <div class="partner">
      <div class="partner-sought">
        <p class="label-k">The collaboration sought</p>
        <ol class="eq eq--ask" aria-label="Partner plus data plus team plus milestone">
          {
            PARTNER.sought.map((s, i) => (
              <li class="eq-term eq-term--plus">
                {i > 0 && (
                  <span class="eq-op">
                    <span aria-hidden="true">+</span>
                    <span class="visually-hidden">plus</span>
                  </span>
                )}
                <span class="eq-box">
                  <strong>{s.k}</strong>
                  {s.body}
                </span>
              </li>
            ))
          }
          <li class="eq-term eq-term--result">
            <span class="eq-op"><span aria-hidden="true">=</span><span class="visually-hidden">equals</span></span>
            <span class="eq-box"><strong>Result</strong>{PARTNER.result}</span>
          </li>
        </ol>
      </div>
      <p class="partner-aud">{PARTNER.audienceLine}</p>
      <AudienceTabs client:visible />
    </div>
  </Chapter>

  <!-- 09 Founder & execution -->
  <Chapter id="founder" title={FOUNDER.title}>
    <div class="founder">
      <div class="founder-card">
        <p class="founder-mono" aria-hidden="true">{FOUNDER.initials}</p>
        <div class="founder-id">
          <h3 class="h3">{FOUNDER.name}</h3>
          <p class="founder-role">{FOUNDER.role} · {FOUNDER.location}</p>
        </div>
        <p class="founder-sum">{FOUNDER.summary}</p>
        <ul class="founder-disc" aria-label="Areas of experience">
          {FOUNDER.disciplines.map((d) => <li>{d}</li>)}
        </ul>
        <a class="link-arrow" href="/about">About Mathsya and the founder <ArrowRight size={16} aria-hidden="true" /></a>
      </div>
      <div class="founder-exec">
        <h3 class="label-k">How execution is organized</h3>
        <dl>
          {
            FOUNDER.execution.map((e) => (
              <div>
                <dt>{e.k}</dt>
                <dd>{e.body}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </Chapter>

  <!-- 10 Next milestone -->
  <Chapter id="milestone" title={MILESTONE.title} lead={MILESTONE.lead} tone="pearl">
    <ol class="ms">
      {
        MILESTONE.items.map((m, i) => (
          <li class="ms-item">
            <span class="ms-n" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p class="ms-body">{m.body}</p>
            <p class="ms-moves">
              <span class="ms-moves-k">Evidence it should produce</span>
              <span class="ms-links">
                {m.moves.map((id) => (
                  <a href={`#${id}`}>
                    {chapter(id).n} {chapter(id).nav}
                  </a>
                ))}
              </span>
            </p>
            <p class="ms-status">
              <span class="inv-meter" aria-hidden="true"><i data-on /><i data-on /><i /></span>
              <span>
                <span class="visually-hidden">Status: </span>Open
              </span>
            </p>
          </li>
        ))
      }
    </ol>
  </Chapter>

  <!-- Resources -->
  <section id="resources" class="inv-res tone-white" aria-labelledby="resources-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="res-titles">
          <p class="eyebrow">Resources</p>
          <h2 id="resources-title" class="inv-ch-title">{RESOURCES.title}</h2>
        </div>
        <p class="lead">{RESOURCES.lead}</p>
      </div>

      <div class="res-featured">
        {
          RESOURCES.featured.map((r) => (
            <a class="resource res-big" href={r.href} download={r.download || undefined}>
              <span class="resource-meta">
                {r.n} / {r.kind}
              </span>
              <span class="res-title">{r.title}</span>
              <span class="res-body">{r.body}</span>
              <span class="resource-meta res-type">
                {r.meta}
                {r.bytes ? ` · ${kb(r.bytes)}` : ''}
              </span>
              <span class="resource-action">
                {r.action} {r.download ? <Download size={16} aria-hidden="true" /> : <ArrowRight size={16} aria-hidden="true" />}
              </span>
            </a>
          ))
        }
      </div>

      <h3 class="res-list-title">Supporting documents</h3>
      <ul class="res-files">
        {
          RESOURCES.files.map((f) => (
            <li>
              <a class="res-row" href={f.href} download>
                <span class="res-row-title">
                  <FileText size={18} aria-hidden="true" />
                  {f.title}
                </span>
                <span class="res-row-body">{f.body}</span>
                <span class="res-row-meta">Markdown · {kb(f.bytes)}</span>
                <span class="res-row-action">
                  Download <Download size={16} aria-hidden="true" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand
    title={'Bring a use case.\nAlign the next investment.'}
    body="Agree the first proof, the team and data needed, the milestone and a paid follow-on path."
    primary={{ label: 'Explore the investment case', href: contactHref('investor') }}
    secondary={{ label: 'Discuss an OEM pilot', href: contactHref('oem-pilot') }}
  />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .inv-hero {
    padding-block: clamp(48px, 5vw, 96px) clamp(64px, 6vw, 112px);
  }
  .inv-hero-title {
    margin-top: 20px;
  }
  .inv-hero-l2 {
    color: var(--c-cobalt-ink);
  }
  .inv-hero-grid {
    display: grid;
    gap: 44px;
    margin-top: clamp(32px, 4vw, 56px);
  }
  @media (min-width: 980px) {
    .inv-hero-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(340px, 0.9fr);
      gap: clamp(48px, 6vw, 112px);
      align-items: start;
    }
  }
  .inv-hero-copy {
    display: grid;
    gap: 28px;
    justify-items: start;
  }
  .inv-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .inv-hero-stage {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    font-size: var(--fs-small);
    color: var(--c-slate);
  }
  .inv-glance {
    border-top: 2px solid var(--c-ink);
    padding-top: 16px;
  }
  .inv-glance-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 10px;
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-slate);
  }
  .inv-glance-title {
    font: inherit;
    letter-spacing: inherit;
    color: var(--c-ink);
  }
  .inv-glance dl {
    margin: 0;
  }
  .inv-glance dl > div {
    display: grid;
    gap: 4px 20px;
    padding: 13px 0;
    border-top: 1px solid var(--c-line);
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  @media (min-width: 480px) {
    .inv-glance dl > div {
      grid-template-columns: 112px minmax(0, 1fr);
    }
  }
  .inv-glance dt {
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-slate);
    padding-top: 2px;
  }
  .inv-glance dd {
    margin: 0;
  }
  .inv-glance-legend {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px solid var(--c-line);
    font-size: var(--fs-xs);
    color: var(--c-slate);
  }

  .label-k {
    font-family: var(--f-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-slate);
  }

  /* ---------- 01 Thesis ---------- */
  .thesis {
    display: grid;
    gap: 48px;
  }
  @media (min-width: 980px) {
    .thesis {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(48px, 7vw, 120px);
    }
  }
  .thesis-copy {
    display: grid;
    gap: 22px;
    align-content: start;
  }
  .thesis-standfirst {
    font-family: var(--f-display);
    font-size: clamp(1.35rem, 1.05rem + 1.1vw, 2rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .thesis-paths-title {
    margin-bottom: 18px;
    font-family: var(--f-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-slate);
  }
  .thesis-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .thesis-list li {
    position: relative;
    display: grid;
    gap: 6px;
    padding: 0 0 30px 40px;
    font-size: var(--fs-small);
    color: var(--c-slate);
  }
  .thesis-list li:last-child {
    padding-bottom: 0;
  }
  .thesis-list li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 22px;
    bottom: 4px;
    width: 1.5px;
    background: var(--c-line-strong);
  }
  .thesis-mark {
    position: absolute;
    left: 0;
    top: 3px;
    width: 16px;
    height: 16px;
    border-radius: 4px;
    background: var(--pc);
  }
  .thesis-k {
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pc-ink);
  }
  .thesis-list .h4 {
    color: var(--c-ink);
  }

  /* ---------- 02 Problem ---------- */
  .stations {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .station {
    position: relative;
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 0 0 30px 38px;
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--c-ink-soft);
  }
  .station:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 9px;
    top: 22px;
    bottom: 2px;
    width: 1.5px;
    background: var(--c-line-strong);
  }
  .station-n {
    position: absolute;
    left: 0;
    top: 2px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1.5px solid var(--c-ink-soft);
    background: var(--c-white);
  }
  .station-k {
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-ink);
  }
  .station.is-gap .station-n {
    border-color: var(--c-cobalt);
    background: var(--c-cobalt);
    box-shadow: 0 0 0 5px var(--c-cobalt-soft);
  }
  .station.is-gap .station-body {
    padding: 14px 16px;
    border-radius: var(--r-s);
    background: var(--c-white);
    border: 1px solid var(--c-cobalt-soft);
    color: var(--c-ink);
  }
  .station-tag {
    justify-self: start;
    padding: 3px 10px;
    border-radius: var(--r-pill);
    background: var(--c-cobalt-soft);
    color: var(--c-cobalt-ink);
    font-family: var(--f-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  @media (min-width: 900px) {
    .stations {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 32px;
    }
    .station {
      padding: 40px 0 0;
    }
    .station:not(:last-child)::before {
      left: 26px;
      right: -26px;
      top: 11px;
      bottom: auto;
      width: auto;
      height: 1.5px;
    }
    .station-n {
      top: 1px;
    }
  }
  .problem-foot {
    display: grid;
    gap: 24px;
    margin-top: clamp(32px, 4vw, 52px);
  }
  @media (min-width: 900px) {
    .problem-foot {
