---
import { ArrowDown, ArrowRight, Download, FileText } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/ui/CtaBand.astro';
import PageNav from '@/components/ui/PageNav.astro';
import { buttonVariants } from '@/components/ui/button';
import Chapter from '@/components/investors/Chapter.astro';
import ValueFlow from '@/components/investors/ValueFlow.astro';
import PortfolioCompare from '@/components/investors/PortfolioCompare.astro';
import ProofTimeline from '@/components/investors/ProofTimeline.astro';
import MarketMap from '@/components/investors/MarketMap';
import '@/components/investors/investors.css';
import { SITE } from '@/data/site';
import { fileSize as kb } from '@/lib/fileSize';
import {
  ACTIONS,
  AT_A_GLANCE,
  BRIEF,
  BUSINESS,
  CHAPTERS,
  COMMERCIAL,
  COMMERCIAL_NOTE,
  EVIDENCE,
  FIRST_APPLICATION,
  FOUNDER,
  HERO,
  NEXT_ASK,
  PORTFOLIO,
  PROBLEM,
  PROOF,
  RESOURCES,
  VALUE,
} from '@/data/investors';

const nav = [...CHAPTERS.map((c) => ({ id: c.id, label: c.nav })), { id: 'resources', label: 'Resources' }];
const oemPaths = COMMERCIAL.filter((c) => c.buyers.includes('oem')).length;
---

<BaseLayout
  title="Investors and Partnerships"
  image="/og/og-investors.png"
  description="Mathsya’s automotive Edge AI portfolio, proposed business models, first partner program and technical and commercial proof milestones."
>
  <!-- Hero: narrative, the three actions and one status summary -->
  <section class="inv-hero tone-white" aria-labelledby="inv-title">
    <div class="container">
      <p class="eyebrow">{HERO.eyebrow}</p>
      <h1 id="inv-title" class="h1 inv-hero-title">
        {HERO.title[0]}<span class="soft-break inv-hero-l2">{HERO.title[1]}</span>
      </h1>
      <div class="inv-hero-grid">
        <div class="inv-hero-copy">
          <p class="lead">{HERO.lead}</p>
          <div class="inv-actions">
            <a class={buttonVariants({ size: 'lg' })} href={ACTIONS.brief.href}>{ACTIONS.brief.label} <ArrowRight aria-hidden="true" /></a>
            <a class={buttonVariants({ variant: 'secondary', size: 'lg' })} href={ACTIONS.invest.href}>{ACTIONS.invest.label}</a>
            <a class={buttonVariants({ variant: 'ghost', size: 'lg' })} href={ACTIONS.pilot.href}>{ACTIONS.pilot.label}</a>
          </div>
          <a class="link-arrow" href="#problem">Read the narrative <ArrowDown size={16} aria-hidden="true" /></a>
        </div>

        <aside class="inv-glance" aria-labelledby="glance-title">
          <div class="inv-glance-head">
            <h2 id="glance-title" class="inv-glance-title">Status summary</h2>
            <span>{BRIEF.date}</span>
          </div>
          <dl>
            <div class="inv-glance-stage">
              <dt>Current stage</dt>
              <dd>{HERO.stage}</dd>
            </div>
            {
              AT_A_GLANCE.map((f) => (
                <div>
                  <dt>{f.k}</dt>
                  <dd>{f.v}</dd>
                </div>
              ))
            }
          </dl>
          <p class="inv-glance-note">{SITE.stage}</p>
        </aside>
      </div>
    </div>
  </section>

  <PageNav items={nav} label="Investor narrative chapters" />

  <!-- 01 Problem -->
  <Chapter id="problem" title={PROBLEM.title} lead={PROBLEM.lead}>
    <ol class="stations" aria-label="From module signal to decision and evidence">
      {
        PROBLEM.stations.map((s, i) => (
          <li class:list={['station', { 'is-gap': s.gap }]}>
            <span class="station-n" aria-hidden="true" />
            <p class="station-k">
              {String(i + 1).padStart(2, '0')} · {s.k}
            </p>
            {s.gap && <p class="station-tag">{PROBLEM.gapLabel}</p>}
            <p class="station-body">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </Chapter>

  <!-- 02 First application -->
  <Chapter id="first-application" title={FIRST_APPLICATION.title} lead={FIRST_APPLICATION.lead} tone="pearl">
    <div class="firstcases">
      <p class="label-k">Candidate first problems</p>
      <ul>
        {FIRST_APPLICATION.cases.map((c) => <li>{c}</li>)}
      </ul>
    </div>
    <ol class="stairs" aria-label="Four steps of the first application">
      {
        FIRST_APPLICATION.steps.map((s, i) => (
          <li style={`--i:${i}`}>
            <p class="stairs-commit">{s.commit}</p>
            <p class="stairs-n">{s.n}</p>
            <h3 class="h4">{s.title}</h3>
            <p class="stairs-body">{s.body}</p>
          </li>
        ))
      }
    </ol>
    <p class="stairs-rule">{FIRST_APPLICATION.rule}</p>
  </Chapter>

  <!-- 03 Products -->
  <Chapter id="portfolio" title={PORTFOLIO.title} lead={PORTFOLIO.lead}>
    <PortfolioCompare />
  </Chapter>

  <!-- 04 Benefits -->
  <Chapter id="value" title={VALUE.title} lead={VALUE.lead} tone="pearl">
    <ValueFlow />
  </Chapter>

  <!-- 05 Adoption and revenue -->
  <Chapter id="business" title={BUSINESS.title} tone="ice">
    <div class="biz">
      <div class="biz-intro">
        <h3 class="h3">Trace an offering to its market</h3>
        <p>
          Select an offering to follow its potential buyer, paid entry and expansion. OEMs appear in {oemPaths} of the {COMMERCIAL.length} proposed paths: one relationship
          could carry several products, provided each earns its own proof.
        </p>
      </div>
      <MarketMap client:visible />

      <div class="table-wrap" tabindex="0" role="region" aria-labelledby="matrix-cap">
        <table class="table biz-table">
          <caption id="matrix-cap">{COMMERCIAL_NOTE}</caption>
          <thead>
            <tr>
              <th scope="col">Offering</th>
              <th scope="col">Potential buyer</th>
              <th scope="col">Proposed commercial path</th>
            </tr>
          </thead>
          <tbody>
            {
              COMMERCIAL.map((c) => (
                <tr>
                  <th scope="row">
                    <span class={`pchip pchip--${c.tone}`}>{c.offering}</span>
                  </th>
                  <td>{c.buyer}</td>
                  <td>
                    {c.entry} <span class="biz-arrow" aria-hidden="true">→</span>
                    <span class="visually-hidden">, then </span>
                    {c.expansion.charAt(0).toLowerCase() + c.expansion.slice(1)}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </Chapter>

  <!-- 06 Proof -->
  <Chapter id="proof" title={PROOF.title} lead={PROOF.lead}>
    <ProofTimeline />
  </Chapter>

  <!-- 07 Founder -->
  <Chapter id="founder" title={FOUNDER.title} lead={FOUNDER.lead} tone="pearl">
    <div class="founder-card">
      <ul class="founder-disc" aria-label="Areas of experience">
        {FOUNDER.disciplines.map((d) => <li>{d}</li>)}
      </ul>
      <a class="link-arrow" href="/about">About Mathsya and the founder <ArrowRight size={16} aria-hidden="true" /></a>
    </div>
  </Chapter>

  <!-- 08 Next ask -->
  <Chapter id="next-ask" title={NEXT_ASK.title} lead={NEXT_ASK.lead}>
    <ol class="eq eq--ask" aria-label="Partner plus access plus work plan plus milestone">
      {
        NEXT_ASK.sought.map((s, i) => (
          <li class="eq-term eq-term--plus">
            {i > 0 && (
              <span class="eq-op">
                <span aria-hidden="true">+</span>
                <span class="visually-hidden">plus</span>
              </span>
            )}
            <span class="eq-box">
              <strong>{s.k}</strong>
              {s.body}
            </span>
          </li>
        ))
      }
      <li class="eq-term eq-term--result">
        <span class="eq-op"><span aria-hidden="true">=</span><span class="visually-hidden">equals</span></span>
        <span class="eq-box"><strong>Result</strong>{NEXT_ASK.result}</span>
      </li>
    </ol>
  </Chapter>

  <!-- 09 Evidence: the one structured section for what is still to be shown -->
  <Chapter id="evidence" title={EVIDENCE.title} lead={EVIDENCE.lead} tone="pearl">
    <div class="table-wrap" tabindex="0" role="region" aria-labelledby="ev-cap">
      <table class="table ev-table">
        <caption id="ev-cap">Milestone plan for the first partner program. Each step is accepted against its agreed gate before the next one starts.</caption>
        <thead>
          <tr>
            <th scope="col">Milestone</th>
            <th scope="col">What it should establish</th>
          </tr>
        </thead>
        <tbody>
          {
            EVIDENCE.milestones.map((m, i) => (
              <tr>
                <th scope="row">
                  <span class="ev-n">{String(i + 1).padStart(2, '0')}</span>
                  {m.step}
                </th>
                <td>{m.establishes}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </Chapter>

  <!-- Resources -->
  <section id="resources" class="inv-res tone-white" aria-labelledby="resources-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="res-titles">
          <p class="eyebrow">Resources</p>
          <h2 id="resources-title" class="inv-ch-title">{RESOURCES.title}</h2>
        </div>
        <p class="lead">{RESOURCES.lead}</p>
      </div>

      <div class="res-featured">
        {
          RESOURCES.featured.map((r) => (
            <a class="resource res-big" href={r.href} download={r.download || undefined}>
              <span class="resource-meta">
                {r.n} / {r.kind}
              </span>
              <span class="res-title">{r.title}</span>
              <span class="res-body">{r.body}</span>
              <span class="resource-meta res-type">
                {r.meta}
                {r.download ? ` · ${kb(r.href)}` : ''}
              </span>
              <span class="resource-action">
                {r.action} {r.download ? <Download size={16} aria-hidden="true" /> : <ArrowRight size={16} aria-hidden="true" />}
              </span>
            </a>
          ))
        }
      </div>

      <h3 class="res-list-title">Supporting documents</h3>
      <ul class="res-files">
        {
          RESOURCES.files.map((f) => (
            <li>
              <a class="res-row" href={f.href} download>
                <span class="res-row-title">
                  <FileText size={18} aria-hidden="true" />
                  {f.title}
                </span>
                <span class="res-row-body">{f.body}</span>
                <span class="res-row-meta">Markdown · {kb(f.href)}</span>
                <span class="res-row-action">
                  Download <Download size={16} aria-hidden="true" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand
    eyebrow="Next step"
    title={'Bring a use case.\nAlign the next investment.'}
    body="Agree the first problem, the access it needs, the acceptance milestone and a costed work plan."
    primary={{ label: ACTIONS.invest.label, href: ACTIONS.invest.href }}
    secondary={{ label: ACTIONS.pilot.label, href: ACTIONS.pilot.href }}
    tertiary={{ label: ACTIONS.brief.label, href: ACTIONS.brief.href }}
  />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .inv-hero {
    padding-block: clamp(48px, 5vw, 96px) clamp(64px, 6vw, 112px);
  }
  .inv-hero-title {
    margin-top: 20px;
  }
  .inv-hero-l2 {
    color: var(--c-cobalt-ink);
  }
  .inv-hero-grid {
    display: grid;
    gap: 44px;
    margin-top: clamp(32px, 4vw, 56px);
  }
  @media (min-width: 980px) {
    .inv-hero-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(340px, 0.9fr);
      gap: clamp(48px, 6vw, 112px);
      align-items: start;
    }
  }
  .inv-hero-copy {
    display: grid;
    gap: 28px;
    justify-items: start;
  }
  .inv-hero-copy .link-arrow {
    padding-block: 8px;
  }
  .inv-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .inv-glance {
    border-top: 2px solid var(--c-ink);
    padding-top: 16px;
  }
  .inv-glance-head {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 10px;
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-slate);
  }
  .inv-glance-title {
    font: inherit;
    letter-spacing: inherit;
    color: var(--c-ink);
  }
  .inv-glance dl {
    margin: 0;
  }
  .inv-glance dl > div {
    display: grid;
    gap: 4px 20px;
    padding: 13px 0;
    border-top: 1px solid var(--c-line);
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  @media (min-width: 480px) {
    .inv-glance dl > div {
      grid-template-columns: 112px minmax(0, 1fr);
    }
  }
  .inv-glance dt {
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-slate);
    padding-top: 2px;
  }
  .inv-glance dd {
    margin: 0;
  }
  .inv-glance-stage dd {
    font-family: var(--f-display);
    font-weight: 650;
    color: var(--c-ink);
  }
  .inv-glance-note {
    padding: 14px 16px;
    border-radius: var(--r-s);
    background: var(--c-ice);
    font-size: var(--fs-xs);
    line-height: 1.55;
    color: var(--c-ink-soft);
  }

  .label-k {
    font-family: var(--f-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-slate);
  }

  /* ---------- 01 Problem ---------- */
  .stations {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .station {
    position: relative;
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 0 0 30px 38px;
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--c-ink-soft);
  }
  .station:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 9px;
    top: 22px;
    bottom: 2px;
    width: 1.5px;
    background: var(--c-line-strong);
  }
  .station-n {
    position: absolute;
    left: 0;
    top: 2px;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1.5px solid var(--c-ink-soft);
    background: var(--c-white);
  }
  .station-k {
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-ink);
  }
  .station.is-gap .station-n {
    border-color: var(--c-cobalt);
    background: var(--c-cobalt);
    box-shadow: 0 0 0 5px var(--c-cobalt-soft);
  }
  .station.is-gap .station-body {
    padding: 14px 16px;
    border-radius: var(--r-s);
    background: var(--c-white);
    border: 1px solid var(--c-cobalt-soft);
    color: var(--c-ink);
  }
  .station-tag {
    justify-self: start;
    padding: 3px 10px;
    border-radius: var(--r-pill);
    background: var(--c-cobalt-soft);
    color: var(--c-cobalt-ink);
    font-family: var(--f-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  @media (min-width: 900px) {
    .stations {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 32px;
    }
    .station {
      padding: 40px 0 0;
    }
    .station:not(:last-child)::before {
      left: 26px;
      right: -26px;
      top: 11px;
      bottom: auto;
      width: auto;
      height: 1.5px;
    }
    .station-n {
      top: 1px;
    }
  }
  .firstcases {
    display: grid;
    gap: 12px;
    margin-bottom: clamp(32px, 4vw, 52px);
  }
  .firstcases ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .firstcases li {
    padding: 8px 14px;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-pill);
    background: var(--c-white);
    font-family: var(--f-display);
    font-weight: 650;
    font-size: 0.92rem;
  }

  /* ---------- 02 First application: staircase ---------- */
  .stairs {
    display: grid;
    gap: 26px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stairs li {
    position: relative;
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 2px 0 0 22px;
    border-left: 2px solid var(--c-ink);
  }
  .stairs-commit {
    justify-self: start;
    padding: 3px 10px;
    border-radius: var(--r-pill);
    background: var(--c-ice);
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-cobalt-ink);
  }
  .stairs li:last-child .stairs-commit {
    background: var(--c-cobalt);
    color: var(--c-white);
  }
  .stairs-n {
    font-family: var(--f-display);
    font-size: 2.2rem;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--c-cobalt);
  }
  .stairs-body {
    font-size: var(--fs-small);
    color: var(--c-slate);
  }
  @media (min-width: 900px) {
    .stairs {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
      align-items: start;
      padding-top: 8px;
    }
    .stairs li {
      margin-top: calc((3 - var(--i)) * 48px);
      padding: 16px 24px 0 18px;
      border-left: 0;
      border-top: 2px solid var(--c-ink);
    }
    .stairs li + li::before {
      content: '';
      position: absolute;
      left: 0;
      top: -2px;
      width: 2px;
      height: 50px;
      background: var(--c-ink);
    }
  }
  .stairs-rule {
    margin-top: clamp(28px, 4vw, 44px);
    padding-top: 16px;
    border-top: 1px solid var(--c-line);
    font-size: var(--fs-small);
    color: var(--c-slate);
  }

  /* ---------- 05 Adoption and revenue ---------- */
  .biz {
    display: grid;
    gap: clamp(40px, 5vw, 64px);
  }
  .biz-intro {
    display: grid;
    gap: 10px;
    max-width: 760px;
    margin-bottom: -16px;
  }
  .biz-intro p {
    color: var(--c-slate);
  }
  .biz-table th[scope='row'] {
    min-width: 210px;
  }
  .biz-arrow {
    color: var(--c-cobalt);
    font-weight: 700;
  }

  /* ---------- 08 Next ask: equation ---------- */
  .eq {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .eq-term {
    display: grid;
    gap: 10px;
    justify-items: start;
  }
  .eq-op {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1.5px solid var(--c-ink);
    font-family: var(--f-mono);
    font-size: 1rem;
    line-height: 1;
    color: var(--c-ink);
  }
  .eq-box {
    display: grid;
    gap: 4px;
    width: 100%;
    padding: 14px 16px;
    border-radius: var(--r-s);
    border: 1px solid var(--c-cobalt-soft);
    background: var(--c-ice);
    font-family: var(--f-display);
    font-size: 0.98rem;
    font-weight: 650;
    line-height: 1.35;
    color: var(--c-ink);
  }
  .eq-term--result .eq-box {
    border-color: var(--c-cobalt);
    background: var(--c-cobalt);
    color: var(--c-white);
  }
  .eq-term--result .eq-op {
    border-color: var(--c-cobalt);
    background: var(--c-cobalt);
    color: var(--c-white);
  }
  .eq--ask .eq-box {
    font-family: var(--f-body);
    font-size: var(--fs-small);
    font-weight: 400;
    background: var(--c-white);
    border-color: var(--c-line-strong);
  }
  .eq--ask .eq-box strong {
    font-family: var(--f-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-cobalt-ink);
  }
  .eq--ask .eq-term--result .eq-box {
    font-family: var(--f-display);
    font-size: 1.05rem;
    font-weight: 700;
    background: var(--c-cobalt);
    border-color: var(--c-cobalt);
  }
  .eq--ask .eq-term--result .eq-box strong {
    color: rgba(255, 255, 255, 0.85);
  }
  @media (min-width: 1100px) {
    .eq {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: 0;
      align-items: stretch;
    }
    .eq-term {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: 0;
    }
    .eq-term:first-child {
      grid-template-columns: minmax(0, 1fr);
    }
    .eq-op {
      margin-inline: 10px;
    }
    .eq-box {
      height: 100%;
      align-content: center;
    }
  }

  /* ---------- 07 Founder ---------- */
  .founder-card {
    display: grid;
    gap: 18px;
    justify-items: start;
  }
  .founder-card .link-arrow {
    padding-block: 8px;
  }
  .founder-disc {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .founder-disc li {
    padding: 6px 12px;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-pill);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--c-ink-soft);
  }
  /* ---------- 09 Evidence ---------- */
  .ev-table th[scope='row'] {
    min-width: 280px;
    font-family: var(--f-display);
    font-weight: 650;
  }
  .ev-n {
    display: block;
    margin-bottom: 4px;
    font-family: var(--f-mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--c-cobalt-ink);
